OPENAI_API_KEY=tu_clave_de_groq
OPENAI_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3
CHAT_MODEL=openai/gpt-oss-120b
PORT=3001
# Opcional. Si tiene valor, exige Authorization: Bearer <token> en la API
# (excepto /health y /files). Generá uno largo y aleatorio.
API_TOKEN=
# Orígenes permitidos por CORS (lista separada por comas). Por defecto:
# https://lecmap.app,https://www.lecmap.app,https://eltinchosf.github.io,http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=

# Timeouts de las llamadas a Groq (ms). Sin ellos un request colgado deja la
# llamada abierta para siempre y al usuario esperando. Default: 150000.
# Quedan debajo del read timeout de Android (180 s).
#STT_TIMEOUT_MS=150000
#LLM_TIMEOUT_MS=150000
