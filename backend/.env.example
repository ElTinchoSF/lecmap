OPENAI_API_KEY=tu_clave_de_groq
OPENAI_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3
CHAT_MODEL=openai/gpt-oss-120b
PORT=3001

# Supabase: conexión a la base de datos y validación de JWT (ES256 via JWKS).
# DATABASE_URL: Supabase → Settings → Database → Connection string (Session pooler).
# SUPABASE_URL: https://<project-ref>.supabase.co (para buscar las claves JWKS).
# Si SUPABASE_URL está vacío, el backend corre sin auth (modo dev).
DATABASE_URL=
SUPABASE_URL=

# Orígenes permitidos por CORS (lista separada por comas).
CORS_ORIGINS=

# Timeouts de las llamadas a Groq (ms). Default: 150000.
#STT_TIMEOUT_MS=150000
#LLM_TIMEOUT_MS=150000

# Proveedor LLM: "gemini" (free tier, recomendado para la beta) o "groq".
# Sin LLM_PROVIDER se auto-detecta: GEMINI_API_KEY presente → gemini; si no, groq.
LLM_PROVIDER=gemini
# Clave de Google AI Studio (https://aistudio.google.com/apikey) — free tier.
GEMINI_API_KEY=
# Modelo LLM (default gemini-2.5-flash; para groq default openai/gpt-oss-120b).
LLM_MODEL=
# Timeout de los calls LLM en ms (default 150000).
LLM_TIMEOUT_MS=

# Worker de transcripción propio (STT + diarización de speakers).
# Vacío → fallback a Groq para STT (solo dev local).
WORKER_URL=
WORKER_TOKEN=
WORKER_TIMEOUT_MS=10800000

# Cola de jobs: intentos máximos y minutos de lock stale.
JOB_MAX_ATTEMPTS=3
JOB_STALE_MIN=10
JOB_CONCURRENCY_TRANSCRIBE=1
JOB_CONCURRENCY_SUMMARIZE=1

# Tamaño máximo de upload de audio en MB (default 200).
MAX_UPLOAD_MB=200
# Directorio de uploads (default ./uploads; en la VM, un volumen montado).
UPLOADS_DIR=
