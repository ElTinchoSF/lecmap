OPENAI_API_KEY=tu_clave_de_groq
OPENAI_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3
CHAT_MODEL=openai/gpt-oss-120b
PORT=3001

# Supabase: conexión a la base de datos y validación de JWT (ES256 via JWKS).
# DATABASE_URL: Supabase → Settings → Database → Connection string (Session pooler).
# SUPABASE_URL: https://<project-ref>.supabase.co (para buscar las claves JWKS).
# Si SUPABASE_URL está vacío, el backend corre sin auth (modo dev).
DATABASE_URL=
SUPABASE_URL=

# Orígenes permitidos por CORS (lista separada por comas).
CORS_ORIGINS=

# Timeouts de las llamadas a Groq (ms). Default: 150000.
#STT_TIMEOUT_MS=150000
#LLM_TIMEOUT_MS=150000
